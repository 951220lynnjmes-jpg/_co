// File name: projects/01/DMux8Way.hdl

/**
 * 8-way demultiplexor:
 * {a, b, c, d, e, f, g, h} = {in, 0, 0, 0, 0, 0, 0, 0} if sel == 000
 *                            {0, in, 0, 0, 0, 0, 0, 0} if sel == 001
 *                            etc.
 *                            {0, 0, 0, 0, 0, 0, 0, in} if sel == 111
 */

CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    // 第一階段：利用最高位元 sel[2] 將輸入訊號分成前半段 (ABCD) 與後半段 (EFGH)
    DMux(in=in, sel=sel[2], a=groupABCD, b=groupEFGH);

    // 第二階段：利用 DMux4Way 搭配低位元 sel[0..1] 分別進行 4 路分流
    DMux4Way(in=groupABCD, sel=sel[0..1], a=a, b=b, c=c, d=d);
    DMux4Way(in=groupEFGH, sel=sel[0..1], a=e, b=f, c=g, d=h);
}