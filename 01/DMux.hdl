// File name: projects/01/DMux.hdl

/**
 * Demultiplexor:
 * {a, b} = {in, 0} if sel == 0
 *          {0, in} if sel == 1
 */

CHIP DMux {
    IN in, sel;
    OUT a, b;

    PARTS:
    // 反轉選擇訊號 sel
    Not(in=sel, out=notSel);

    // 當 sel 為 0 (notSel 為 1) 時，a = in；否則 a = 0
    And(a=in, b=notSel, out=a);

    // 當 sel 為 1 時，b = in；否則 b = 0
    And(a=in, b=sel, out=b);
}
