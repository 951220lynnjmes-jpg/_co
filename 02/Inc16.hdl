// File name: projects/02/Inc16.hdl

/**
 * 16-bit incrementer:
 * out = in + 1 (arithmetic addition)
 */

CHIP Inc16 {
    IN in[16];
    OUT out[16];

    PARTS:
   // 將輸入 in 與 1 (b[0]=true, 其餘預設為 false) 送入 Add16 進行加法運算
    Add16(a=in, b[0]=true, out=out);
}