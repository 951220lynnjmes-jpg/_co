import sys
import os


class SymbolTable:

    def __init__(self):
        # 初始化內建預定義符號
        self.table = {
            "SP": 0,
            "LCL": 1,
            "ARG": 2,
            "THIS": 3,
            "THAT": 4,
            "R0": 0,
            "R1": 1,
            "R2": 2,
            "R3": 3,
            "R4": 4,
            "R5": 5,
            "R6": 6,
            "R7": 7,
            "R8": 8,
            "R9": 9,
            "R10": 10,
            "R11": 11,
            "R12": 12,
            "R13": 13,
            "R14": 14,
            "R15": 15,
            "SCREEN": 16384,
            "KBD": 24576,
        }
        self.next_variable_address = 16

    def add_entry(self, symbol: str, address: int):
        self.table[symbol] = address

    def contains(self, symbol: str) -> bool:
        return symbol in self.table

    def get_address(self, symbol: str) -> int:
        return self.table[symbol]

    def allocate_variable(self, symbol: str) -> int:
        address = self.next_variable_address
        self.add_entry(symbol, address)
        self.next_variable_address += 1
        return address


class Code:
    # C-指令對應表
    DEST_TABLE = {
        "": "000",
        "M": "001",
        "D": "010",
        "MD": "011",
        "A": "100",
        "AM": "101",
        "AD": "110",
        "AMD": "111",
    }

    JUMP_TABLE = {
        "": "000",
        "JGT": "001",
        "JEQ": "010",
        "JGE": "011",
        "JLT": "100",
        "JNE": "101",
        "JLE": "110",
        "JMP": "111",
    }

    COMP_TABLE = {
        # a = 0
        "0": "0101010",
        "1": "0111111",
        "-1": "0111010",
        "D": "0001100",
        "A": "0110000",
        "!D": "0001101",
        "!A": "0110001",
        "-D": "0001111",
        "-A": "0110011",
        "D+1": "0011111",
        "A+1": "0110111",
        "D-1": "0001110",
        "A-1": "0110010",
        "D+A": "0000010",
        "D-A": "0010011",
        "A-D": "0000111",
        "D&A": "0000000",
        "D|A": "0010101",
        # a = 1
        "M": "1110000",
        "!M": "1110001",
        "-M": "1110011",
        "M+1": "1110111",
        "M-1": "1110010",
        "D+M": "1000010",
        "D-M": "1010011",
        "M-D": "1000111",
        "D&M": "1000000",
        "D|M": "1010101",
    }

    @classmethod
    def dest(cls, mnemonic: str) -> str:
        return cls.DEST_TABLE[mnemonic]

    @classmethod
    def comp(cls, mnemonic: str) -> str:
        return cls.COMP_TABLE[mnemonic]

    @classmethod
    def jump(cls, mnemonic: str) -> str:
        return cls.JUMP_TABLE[mnemonic]


class Parser:

    def __init__(self, lines: list[str]):
        self.instructions = []
        for line in lines:
            # 去除註解與前後空白
            clean_line = line.split("//")[0].strip().replace(" ", "")
            if clean_line:
                self.instructions.append(clean_line)

    @staticmethod
    def instruction_type(inst: str) -> str:
        if inst.startswith("@"):
            return "A_INSTRUCTION"
        elif inst.startswith("(") and inst.endswith(")"):
            return "L_INSTRUCTION"
        else:
            return "C_INSTRUCTION"

    @staticmethod
    def symbol(inst: str) -> str:
        if inst.startswith("@"):
            return inst[1:]
        return inst[1:-1]

    @staticmethod
    def parse_c_instruction(inst: str) -> tuple[str, str, str]:
        dest, jump = "", ""
        comp_part = inst

        if "=" in comp_part:
            dest, comp_part = comp_part.split("=", 1)
        if ";" in comp_part:
            comp, jump = comp_part.split(";", 1)
        else:
            comp = comp_part

        return dest, comp, jump


def assemble(asm_file_path: str):
    with open(asm_file_path, "r", encoding="utf-8") as f:
        lines = f.readlines()

    parser = Parser(lines)
    symbol_table = SymbolTable()

    # 第一遍掃描 (First Pass): 記錄所有標籤 (L_INSTRUCTION) 的 ROM 位址
    rom_address = 0
    for inst in parser.instructions:
        inst_type = Parser.instruction_type(inst)
        if inst_type == "L_INSTRUCTION":
            label = Parser.symbol(inst)
            symbol_table.add_entry(label, rom_address)
        else:
            rom_address += 1

    # 第二遍掃描 (Second Pass): 翻譯指令並處理變數
    machine_code = []
    for inst in parser.instructions:
        inst_type = Parser.instruction_type(inst)

        if inst_type == "A_INSTRUCTION":
            sym = Parser.symbol(inst)
            if sym.isdigit():
                address = int(sym)
            else:
                if not symbol_table.contains(sym):
                    address = symbol_table.allocate_variable(sym)
                else:
                    address = symbol_table.get_address(sym)
            # 格式化為 16-bit 二進位 (最高位為 0)
            machine_code.append(f"0{address:015b}")

        elif inst_type == "C_INSTRUCTION":
            dest, comp, jump = Parser.parse_c_instruction(inst)
            c_bits = Code.comp(comp)
            d_bits = Code.dest(dest)
            j_bits = Code.jump(jump)
            # C-指令前三位固定為 111
            machine_code.append(f"111{c_bits}{d_bits}{j_bits}")

    # 輸出 .hack 檔案
    output_path = os.path.splitext(asm_file_path)[0] + ".hack"
    with open(output_path, "w", encoding="utf-8") as f:
        f.write("\n".join(machine_code) + "\n")

    print(f"組譯完成：{output_path}")


if __name__ == "__main__":
    if len(sys.argv) != 2:
        print("使用方式: python assembler.py <檔案路徑.asm>")
        sys.exit(1)
    assemble(sys.argv[1])